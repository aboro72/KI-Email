APP_NAME=KI-Email
# MongoDB-Produktivbetrieb:
# DATABASE_URL=mongodb://aborodesk_app:PASSWORT@212.44.166.238:27017/aborodesk?authSource=admin
DATABASE_URL=sqlite:///./ki_email.db
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
SESSION_COOKIE_SECURE=false
BEDROCK_REGION=eu-central-1
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
BEDROCK_API_KEY_FILE=bedrock-long-term-api-key.csv
AI_PROVIDER=bedrock
# Vorübergehend Qwen über Nova: AI_PROVIDER=nova, NOVA_MODEL=local
NOVA_BASE_URL=https://ki.ml-projekt.de/v1
NOVA_MODEL=local
NOVA_API_KEY=
NOVA_REQUEST_TIMEOUT=180
NOVA_MAX_RETRIES=3
# Für alle App-Prozesse dieselbe Datei verwenden; Linux z.B. /var/lib/aborodesk/nova-request.lock
NOVA_REQUEST_LOCK_FILE=.nova-request.lock

# Optionales Projektplanungsmodul; Rechte zusätzlich unter Administration/Rollen vergeben.
PROJECTS_ENABLED=true
# Alle Webprozesse auf diesem Server müssen dieselbe Sperrdatei verwenden.
PROJECT_LOCK_FILE=.project-planning.lock

# Personalmanagement; Modulrechte in Administration/Rollen vergeben.
HRM_ENABLED=true

# Kaufmännische Verwaltung; zusätzliche ERP-Rechte unter Administration/Rollen.
ERP_ENABLED=true
# Alle Webprozesse und der Worker müssen dieselbe Sperrdatei verwenden.
ERP_LOCK_FILE=.erp.lock
# Alle Webprozesse und der Worker müssen dieselbe beschreibbare Datei verwenden.
HRM_LOCK_FILE=.hrm.lock
# Separater privater Personalordner; darf nicht dem Datei- oder Vertragsordner entsprechen.
HRM_CLOUDSHARE_FOLDER_ID=0

# Optionaler, gemeinsamer CloudShare-Ablageordner. Standardmäßig ausgeschaltet.
# Rechte: DOCUMENTS_VIEW, DOCUMENTS_UPLOAD, DOCUMENTS_EDIT (zunächst nur Admin).
DOCUMENTS_ENABLED=false
CONTRACTS_ENABLED=true
CLOUDSHARE_BASE_URL=https://cloudshare.aborosoft.com
CLOUDSHARE_USERNAME=
CLOUDSHARE_PASSWORD=
CLOUDSHARE_FOLDER_ID=0
# Separater CloudShare-Unterordner, damit allgemeine Ablagenutzer keine Verträge sehen.
CONTRACTS_CLOUDSHARE_FOLDER_ID=0
UI_LANGUAGE=de
CLOUDSHARE_TIMEOUT=60
DOCUMENTS_MAX_BYTES=26214400
OFFICE_BASE_URL=https://office.aborosoft.com
