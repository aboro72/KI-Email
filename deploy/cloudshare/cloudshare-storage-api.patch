+def save_file_revision(file_obj, content, description, expected_count=None):
+    """Keep old file paths intact and serialize revision numbers per document."""
+    with transaction.atomic():
+        file_obj = StorageFile.objects.select_for_update().get(pk=file_obj.pk)
+        if expected_count is not None and file_obj.version_count != expected_count:
+            raise ValueError('Document changed; reload its version history')
+        # Storage backend chooses a fresh name; previous FileVersion keeps its bytes.
+        file_obj.file.save(file_obj.name, ContentFile(content), save=False)
+        file_obj.file_hash = ''
+        file_obj.save()
+        number = (file_obj.versions.aggregate(n=Max('version_number'))['n'] or 0) + 1
+        file_obj.versions.update(is_current=False)
+        FileVersion.objects.create(
+            file=file_obj, version_number=number, file_data=file_obj.file.name,
+            file_hash=file_obj.file_hash, size=file_obj.size,
+            change_description=description, is_current=True,
+        )
+        file_obj.refresh_from_db()
+        return file_obj
+
+
